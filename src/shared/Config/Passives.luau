--!strict
-- Passive tree data (spec 4.5). 40 nodes: a start node plus three arms of 13.
-- Each arm: a trunk to a notable branch point, two branches that each end in a
-- notable with a side spur, then a merge into the keystone at the tip.
-- Coordinates are UI pixels around the start at (0, 0); y grows downward.
-- Links are listed on both ends. Mod ops: damage/cooldown/aoe/shield use "mul",
-- everything else uses "add". Keystones change rules through `keystone`.
export type Region = "might" | "swift" | "insight" | "core"
export type Kind = "start" | "small" | "notable" | "keystone"
export type Mod = { stat: string, op: "add" | "mul", value: number }
export type Node = {
	id: string,
	region: Region,
	kind: Kind,
	name: string,
	mods: { Mod },
	keystone: string?,
	x: number,
	y: number,
	links: { string },
}

export type PassivesConfig = {
	startId: string,
	nodes: { [string]: Node },
	regions: { [string]: { name: string, keystone: string } },
}

