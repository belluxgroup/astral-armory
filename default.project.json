{
  "name": "AstralArmory",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": { "EnableMouseLockOption": false },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Workspace": {
      "$properties": { "StreamingEnabled": true, "FallenPartsDestroyHeight": -50 },
      "Arena": { "$path": "assets/Arena.rbxm" }
    },
    "TextChatService": {
      "$properties": { "ChatVersion": "TextChatService" }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 17.6,
        "Brightness": 2.2,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.8,
        "OutdoorAmbient": [0.35, 0.3, 0.4],
        "Ambient": [0.12, 0.1, 0.16],
        "GlobalShadows": true
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.32,
          "Offset": 0.15,
          "Haze": 1.6,
          "Glare": 0.4,
          "Color": [1.0, 0.72, 0.55],
          "Decay": [0.42, 0.28, 0.55]
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": { "Intensity": 0.6, "Size": 28, "Threshold": 1.6 }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Contrast": 0.12,
          "Saturation": 0.08,
          "TintColor": [1.0, 0.95, 0.9]
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": { "Intensity": 0.06, "Spread": 0.6 }
      },
      "Sky": {
        "$className": "Sky",
        "$properties": { "CelestialBodiesShown": true, "StarCount": 3000 }
      }
    }
  }
}
