--!strict
local R = require("../src/shared/Logic/SkillResolver")
local Stats = require("../src/shared/Logic/Stats")
local Cfg = require("../src/shared/Config/Passives")
local function ks(name)
	for id, n in Cfg.nodes do
		if n.keystone == name then
			return id
		end
	end
	error(name)
end
local base = Stats.compute(1, { start = true }, { transformed = false })
return function(t)
	t.test("blade_rain base", function()
		local s = R.resolve("blade_rain", {}, base, false)
		t.eq(s.count, 12)
		t.near(s.damage, 18)
		t.near(s.cooldown, 6)
		t.eq(s.cost, 30)
		t.eq(s.costResource, "energy")
		t.near(s.radius, 14)
		t.eq(s.element, "none")
		t.eq(s.radiant, false)
	end)
	t.test("multishot adds blades and lowers damage", function()
		local s = R.resolve("blade_rain", { "multishot" }, base, false)
		t.eq(s.count, 16)
		t.near(s.damage, 18 * 0.85)
	end)
	t.test("multishot + endless_arsenal", function()
		local st = Stats.compute(1, { start = true, [ks("endless_arsenal")] = true }, { transformed = false })
		local s = R.resolve("blade_rain", { "multishot" }, st, false)
		t.eq(s.count, 22)
		t.near(s.damage, 18 * st.damageMul * 0.85 * 0.75, 1e-9)
	end)
	t.test("endless_arsenal only touches blade_rain", function()
		local st = Stats.compute(1, { start = true, [ks("endless_arsenal")] = true }, { transformed = false })
		local s = R.resolve("crimson_lance", {}, st, false)
		t.eq(s.count, 1)
		t.near(s.damage, 60 * st.damageMul, 1e-9)
	end)
	t.test("lance multishot spread", function()
		local s = R.resolve("crimson_lance", { "multishot" }, base, false)
		t.eq(s.count, 3)
		t.eq(s.spreadDeg, 20)
		t.eq(s.pierce, true)
		t.eq(R.resolve("crimson_lance", {}, base, false).spreadDeg, nil)
		t.eq(R.resolve("blade_rain", { "multishot" }, base, false).spreadDeg, nil)
	end)
	t.test("swift_cast, frost, wide_burst", function()
		t.near(R.resolve("blade_rain", { "swift_cast" }, base, false).cooldown, 4.5)
		t.eq(R.resolve("dawnbreaker", { "frost" }, base, false).element, "frost")
		local w = R.resolve("blade_rain", { "wide_burst" }, base, false)
		t.near(w.radius, 14 * 1.4)
		t.eq(w.impactExplosion, true)
		t.eq(R.resolve("blade_rain", {}, base, false).impactExplosion, false)
	end)
	t.test("config numbers are copied", function()
		local d = R.resolve("dawnbreaker", {}, base, false)
		t.eq(d.length, 40)
		t.eq(d.width, 8)
		t.eq(d.channel, 1.2)
		t.eq(d.range, 40)
		local l = R.resolve("crimson_lance", {}, base, false)
		t.eq(l.speed, 120)
		t.eq(l.range, 80)
		t.eq(R.resolve("hex_aegis", {}, base, false).duration, 3)
		t.eq(R.resolve("hex_aegis", {}, base, false).damage, 0)
		t.eq(R.resolve("basic", {}, base, false).pierce, false)
	end)
	t.test("passive stats scale damage, cooldown and radius", function()
		local st = table.clone(base)
		st.damageMul, st.cooldownMul, st.aoeMul = 1.2, 0.9, 1.1
		local s = R.resolve("blade_rain", { "multishot", "wide_burst" }, st, false)
		t.near(s.damage, 18 * 1.2 * 0.85, 1e-9)
		t.near(s.cooldown, 6 * 0.9, 1e-9)
		t.near(s.radius, 14 * 1.1 * 1.4, 1e-9)
	end)
	t.test("transform bonus comes from stats, radiant from the flag", function()
		local tr = Stats.compute(10, { start = true }, { transformed = true })
		local s = R.resolve("crimson_lance", {}, tr, true)
		t.near(s.damage, 60 * 1.3, 1e-9)
		t.eq(s.radiant, true)
	end)
	t.test("blood_oath pays with hp", function()
		local st = Stats.compute(1, { start = true, [ks("blood_oath")] = true }, { transformed = false })
		local s = R.resolve("crimson_lance", {}, st, false)
		t.eq(s.costResource, "hp")
		t.eq(s.cost, 25)
	end)
	t.test("radiant flag and radiant_mind ascension", function()
		t.eq(R.resolve("blade_rain", {}, base, true).radiant, true)
		local st = Stats.compute(10, { start = true, [ks("radiant_mind")] = true }, { transformed = false })
		local a = R.resolve("ascension", {}, st, false)
		t.eq(a.duration, math.huge)
		t.eq(a.drainPerSec, 6)
		local plain = R.resolve("ascension", {}, base, false)
		t.eq(plain.duration, 20)
		t.eq(plain.drainPerSec, nil)
	end)
	t.test("shield absorb scales", function()
		t.near(R.resolve("hex_aegis", {}, base, false).absorb, 80)
		local st = table.clone(base)
		st.shieldMul = 1.25
		t.near(R.resolve("hex_aegis", {}, st, false).absorb, 100)
	end)
	t.test("unknown gems are ignored, unknown skills error", function()
		t.eq(R.resolve("blade_rain", { "nope" }, base, false).count, 12)
		t.eq((pcall(R.resolve, "nope", {}, base, false)), false)
	end)
end
